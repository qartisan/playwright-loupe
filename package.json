{
  "name": "@qartisan/playwright-loupe",
  "version": "0.1.1",
  "description": "HTML reporter for Playwright: dashboard, error groups by normalized signature, tests by project and suite, dimensions from tags and annotations.",
  "keywords": [
    "playwright",
    "reporter",
    "test-report",
    "e2e-testing"
  ],
  "license": "MIT",
  "type": "module",
  "homepage": "https://qartisan.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qartisan/playwright-loupe.git"
  },
  "bugs": {
    "url": "https://github.com/qartisan/playwright-loupe/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "licenses",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:core && npm run build:renderer",
    "build:core": "tsc -p tsconfig.build.json",
    "build:renderer": "vite build",
    "dev:renderer": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/renderer/tsconfig.json",
    "pretest": "npm run build",
    "test": "vitest run",
    "fixtures": "npm run build && node scripts/run-fixtures.mjs",
    "sample:update": "npm run build && node scripts/update-sample.mjs",
    "perf:sample": "npm run build && node scripts/perf-sample.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "peerDependencies": {
    "@playwright/test": "^1.52.0"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@preact/signals": "^2.11.3",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "preact": "^10.29.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
